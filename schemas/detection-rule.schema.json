{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.security/schemas/detection-rule/v1",
  "title": "DetectionRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "version", "name", "description", "severity", "conditions"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "match_mode": {"type": "string", "enum": ["all", "any"], "default": "all"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "enabled": {"type": "boolean", "default": true},
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator"],
        "properties": {
          "field": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$"},
          "operator": {"type": "string", "enum": ["eq", "neq", "in", "not_in", "contains", "regex", "exists", "gt", "gte", "lt", "lte"]},
          "value": {}
        }
      }
    }
  }
}
